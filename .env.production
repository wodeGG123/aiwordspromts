# ============================================================
# 必填配置（服务器部署必须设置）
# ============================================================

# AI API Key（必填，生产环境不允许为空）
AI_API_KEY=your-api-key-here

# AI 模型名称
AI_MODEL=deepseek-v4-flash-ga-260731

# 允许访问的前端来源（生产环境必须填具体地址，禁止填 *）
# 多个地址用逗号分隔
CLIENT_ORIGINS=https://your-frontend-domain.com

# ============================================================
# 可选配置（已有默认值，可按需覆盖）
# ============================================================

# 服务器端口（默认 3000）
PORT=3000

# AI 后端地址（默认使用火山引擎 OpenAI 兼容 API）
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 请求体最大字节数（默认 8MB）
# REQUEST_MAX_BYTES=8388608

# AI 输出最大字符数（默认 256KB）
# AI_MAX_OUTPUT_CHARS=262144

# AI 最大 completion tokens（默认 16384）
# AI_MAX_COMPLETION_TOKENS=16384

# SSE 心跳间隔毫秒（默认 5000）
# SSE_HEARTBEAT_MS=5000

# 每 IP 每分钟最大请求数（默认 30）
# RATE_LIMIT_PER_MINUTE=30

# 每 IP 最大并发数（默认 2）
# MAX_CONCURRENT_PER_IP=2

# ============================================================
# 提示词安全过滤（可选）
# ============================================================

# 是否启用提示词过滤（默认 true）
# ENABLE_PROMPT_FILTER=true

# 过滤关键词列表，逗号分隔（默认空）
# PROMPT_BLACKLIST=违禁词1,违禁词2

# ============================================================
# 反向代理（用于解决客户端跨域问题）
# ============================================================

# 是否启用反向代理（默认 true）
# PROXY_ENABLED=true

# 代理服务端口（默认 3001）
# PROXY_PORT=3001

# 代理目标地址（默认 dimecho 游戏后端）
# PROXY_TARGET=https://f8q3w6v1.dimecho.com

# ============================================================
# APK 配置（可选，客户端下载用）
# ============================================================

# APK 配置文件路径（默认读取项目根目录 apk-info.json）
# APK_INFO_FILE=/path/to/apk-info.json

# ============================================================
# 运行模式
# ============================================================

# NODE_ENV=production
